<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/widget_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_logo"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/w_query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_hint"
            android:textColor="@color/w_ink3"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_hint"
            android:src="@drawable/ic_widget_search" />

        <ImageView
            android:id="@+id/w_clear"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="지우기"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            android:tint="@color/w_ink2"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:text="@string/widget_recent"
        android:textColor="@color/w_ink2"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card">

        <ListView
            android:id="@+id/w_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/widget_empty"
            android:textColor="@color/w_ink2"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
